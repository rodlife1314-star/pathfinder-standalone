# Copy to .env.local (git-ignored). Read ONLY on the server (app/api/orion/route.ts,
# scripts/orion-eval.ts). Never prefix with NEXT_PUBLIC_ — that would ship the key to the browser.
#
# No defaults for provider or model: the Human Operator chooses both explicitly.
ORION_PROVIDER=            # anthropic | openai | gemini | openai-compatible
ORION_MODEL=               # exact model id as published by the provider
ORION_API_KEY=
# ORION_BASE_URL=          # optional for anthropic/openai/gemini (official host by default); REQUIRED for openai-compatible
# ORION_EFFORT=            # optional; provider-specific reasoning depth (validated per provider)
# ORION_TIMEOUT_MS=120000  # 1000–600000
# ORION_MAX_OUTPUT_TOKENS=16000  # 256–64000
# Requests per client per minute to /api/orion (in-memory, per server process)
# ORION_RATE_LIMIT_PER_MIN=10
