# Copy to .env.local (git-ignored). Read ONLY by the server-side route app/api/orion/route.ts.
# Never prefix with NEXT_PUBLIC_ — that would ship the key to the browser.
ORION_API_KEY=
ORION_BASE_URL=https://integrate.api.nvidia.com/v1
ORION_MODEL=z-ai/glm-5.3-flash
ORION_TIMEOUT_MS=30000
ORION_MAX_TOKENS=1024
ORION_TEMPERATURE=0.5
# Requests per client per minute to /api/orion (in-memory, per server process)
ORION_RATE_LIMIT_PER_MIN=10
